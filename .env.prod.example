# ══════════════════════════════════════════════════════════════════════════════
#  Congreso Ingenierías 2026 — Variables de entorno de PRODUCCIÓN
#  Copiar este archivo a .env y completar los valores secretos.
#  NUNCA subir el .env real al repositorio Git.
# ══════════════════════════════════════════════════════════════════════════════

# URL pública del sitio (sin barra al final)
APP_URL=http://congreso2026.bucaramanga.upb.edu.co

# Dominio para sesiones de Sanctum (solo el dominio, sin http://)
SANCTUM_STATEFUL_DOMAINS=congreso2026.bucaramanga.upb.edu.co

# Clave de aplicación Laravel — generar con: php artisan key:generate --show
APP_KEY=base64:CAMBIAR_POR_KEY_GENERADA

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_DATABASE=congreso_db
DB_USERNAME=congreso
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_ROOT_PASSWORD=CAMBIAR_POR_ROOT_PASSWORD_SEGURO

# ── Redis ──────────────────────────────────────────────────────────────────────
# Contraseña interna de Redis (solo accesible entre contenedores)
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_REDIS_SEGURO

# ── Correo electrónico ────────────────────────────────────────────────────────
# Opción A — SMTP institucional UPB (pedir credenciales a CTIC):
MAIL_MAILER=smtp
MAIL_HOST=smtp.upb.edu.co
MAIL_PORT=587
MAIL_USERNAME=congreso2026@upb.edu.co
MAIL_PASSWORD=CAMBIAR_POR_PASSWORD_CORREO
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=congreso2026@upb.edu.co
MAIL_FROM_NAME="Congreso Ingenierías 2026"

# Opción B — Resend (resend.com, gratis hasta 3.000 correos/mes):
# MAIL_MAILER=resend
# RESEND_KEY=re_CAMBIAR_POR_API_KEY
# MAIL_FROM_ADDRESS=congreso@tudominio.com
# MAIL_FROM_NAME="Congreso Ingenierías 2026"

# ── Cloudflare Stream ─────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=CAMBIAR_POR_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=CAMBIAR_POR_API_TOKEN
CLOUDFLARE_STREAM_WEBHOOK_SECRET=CAMBIAR_POR_WEBHOOK_SECRET
